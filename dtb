-- ========== HELPERS ==========
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getRemotes()
    local ok, remotes = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes", 10)
    end)
    return ok and remotes or nil
end

local function getBall()
    -- tenta achar algo com "Ball" no nome que seja BasePart
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("ball") then
            return v
        end
    end
    return nil
end

local function getBoss()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and (v.Name:lower():find("boss") or v.Name:lower():find("enemy")) then
            return v
        end
    end
    return nil
end

local function randomize(base, spread)
    return base + (math.random() * spread * 2 - spread)
end

-- ========== COMBAT ==========
local function tryParry()
    local remotes = getRemotes()
    if not remotes then return end
    local parry = remotes:FindFirstChild("ParryButtonPress")
    if not parry then return end
    parry:Fire()
end

local function autoParryLoop()
    task.spawn(function()
        while State.AutoParry do
            local root = getRoot()
            local ball = getBall()
            if root and ball then
                local dist = (ball.Position - root.Position).Magnitude
                if dist <= State.ParryRange then
                    local now = tick()
                    local waitTime = State.ParryDelay + State.PingComp
                    if State.LegitMode then
                        waitTime = randomize(waitTime, 0.06) -- ±60ms
                    end
                    if now - State.LastParry >= math.max(waitTime, 0.04) then
                        tryParry()
                        State.LastParry = now
                    end
                end
            end
            task.wait(0.01)
        end
    end)
end

local function autoAbilityLoop()
    task.spawn(function()
        while State.AutoAbility do
            local root = getRoot()
            local ball = getBall()
            if root and ball then
                local dist = (ball.Position - root.Position).Magnitude
                if dist <= State.ParryRange * 0.7 then
                    -- fallback: tenta disparar ability remote se existir
                    local remotes = getRemotes()
                    if remotes then
                        local ability = remotes:FindFirstChild("Ability") or remotes:FindFirstChild("UseAbility")
                        if ability then
                            ability:FireServer()
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

-- ========== MOVEMENT ==========
local function startFly()
    local root = getRoot()
    local hum = getHum()
    if not root or not hum then return end
    if State.FlyBV then State.FlyBV:Destroy() end
    if State.FlyBG then State.FlyBG:Destroy() end
    State.FlyBV = Instance.new("BodyVelocity")
    State.FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    State.FlyBV.Velocity = Vector3.zero
    State.FlyBV.Parent = root
    State.FlyBG = Instance.new("BodyGyro")
    State.FlyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    State.FlyBG.P = 1000
    State.FlyBG.D = 50
    State.FlyBG.CFrame = root.CFrame
    State.FlyBG.Parent = root
    hum.PlatformStand = true
end

local function stopFly()
    if State.FlyBV then State.FlyBV:Destroy(); State.FlyBV = nil end
    if State.FlyBG then State.FlyBG:Destroy(); State.FlyBG = nil end
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

RunService.Heartbeat:Connect(function()
    if not State.Fly then return end
    local root = getRoot()
    local cam = Workspace.CurrentCamera
    local hum = getHum()
    if not root or not cam or not hum then return end
    local moveDir = hum.MoveDirection
    local vertical = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = vertical - 1 end
    if State.FlyBV then
        State.FlyBV.Velocity = (moveDir * State.FlySpeed) + Vector3.new(0, vertical * State.FlySpeed, 0)
    end
    if State.FlyBG then
        State.FlyBG.CFrame = cam.CFrame
    end
end)

UserInputService.JumpRequest:Connect(function()
    if State.InfJump then
        local hum = getHum()
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

RunService.Stepped:Connect(function()
    if State.Noclip then
        local char = getChar()
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end
    end
end)

-- ========== FARM ==========
local function farmBossLoop()
    task.spawn(function()
        while State.AutoFarmBoss do
            local root = getRoot()
            local boss = getBoss()
            if root and boss then
                local bossRoot = boss:FindFirstChild("HumanoidRootPart") or boss:FindFirstChildWhichIsA("BasePart")
                if bossRoot then
                    root.CFrame = CFrame.new(bossRoot.Position + Vector3.new(0, State.FarmHeight, 0))
                    -- tenta atacar via remote de combate se existir
                    local remotes = getRemotes()
                    if remotes then
                        local attack = remotes:FindFirstChild("Attack") or remotes:FindFirstChild("Swing")
                        if attack then
                            attack:FireServer()
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

local function autoReadyLoop()
    task.spawn(function()
        while State.AutoReady do
            local root = getRoot()
            if root then
                -- tenta achar spawn/ready zone
                local ready = Workspace:FindFirstChild("ReadyZone") or Workspace:FindFirstChild("SpawnLocation")
                if ready and ready:IsA("BasePart") then
                    root.CFrame = CFrame.new(ready.Position + Vector3.new(0, 3, 0))
                end
            end
            task.wait(1)
        end
    end)
end

-- ========== VISUAL ==========
local function refreshESP()
    -- jogadores
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("DB_ESP")
            if State.ESPPlayers then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "DB_ESP"
                    hl.FillColor = Color3.fromRGB(255, 60, 60)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = p.Character
                end
            elseif hl then
                hl:Destroy()
            end
        end
    end
    -- bola
    local ball = getBall()
    if ball then
        local hl = ball:FindFirstChild("DB_BallESP")
        if State.ESPBall then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "DB_BallESP"
                hl.FillColor = Color3.fromRGB(255, 220, 0)
                hl.OutlineColor = Color3.fromRGB(255, 140, 0)
                hl.Parent = ball
            end
        elseif hl then
            hl:Destroy()
        end
    end
end

-- ========== MISC ==========
local function hideUI()
    State.Hidden = not State.Hidden
    local gui = LocalPlayer:WaitForChild("PlayerGui")
    local rayfieldGui = gui:FindFirstChild("Rayfield")
    if rayfieldGui then
        rayfieldGui.Enabled = not State.Hidden
    end
    if State.Hidden then
        local hint = Instance.new("Hint")
        hint.Name = "DB_Hint"
        hint.Text = "[K]vk hub escondido — END para panic"
        hint.Parent = Workspace
        task.delay(4, function() hint:Destroy() end)
    end
end

-- ========== PANIC ==========
local function panic()
    State.AutoParry = false
    State.AutoAbility = false
    State.AutoFarmBoss = false
    State.AutoReady = false
    State.Fly = false
    State.InfJump = false
    State.Noclip = false
    State.ESPPlayers = false
    State.ESPBall = false
    stopFly()
    refreshESP()
    Rayfield:Notify({ Title = "Panic", Content = "tudo desligado.", Duration = 4 })
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.End then
        panic()
    end
    if input.KeyCode == Enum.KeyCode.RightShift then
        hideUI()
    end
end)

